POSTGRES_USER=facewatch
POSTGRES_PASSWORD=facewatch
POSTGRES_DB=facewatch
SECRET_KEY=please-change-me-to-a-long-random-string
# 32-byte url-safe base64 ключ для Fernet (можно сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
RTSP_ENCRYPTION_KEY=ZmFjZXdhdGNoLWRldi1rZXktMzJieXRlcy1iYXNlNjQ=
ADMIN_PASSWORD=admin
# Пароль Control API MediaMTX: им воркер заводит пути записи и читает
# статусы потоков. Значение попадает и в mediamtx (MTX_AUTHINTERNALUSERS_1_PASS),
# и в воркер (MEDIAMTX_API_URL) — менять надо только здесь. Наружу порт
# Control API не публикуется, но без пароля MediaMTX не пустит воркер вовсе:
# анонимный доступ к api он даёт только с loopback.
MEDIAMTX_API_PASSWORD=facewatch-mediamtx-api
# Значение по умолчанию; после старта меняется в UI «Настройки» (хранится в БД)
RETENTION_DAYS=30
# Бэкенд апскейла лиц: gfpgan (нейросеть, качественнее) или opencv (лёгкий fallback)
UPSCALE_BACKEND=gfpgan
# Источники, которым разрешён CORS (через запятую). В production не нужен —
# фронтенд и API идут через один nginx (same-origin). Нужен только для
# локальной разработки с отдельным dev-сервером фронтенда.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Расписание автоматического бэкапа PostgreSQL (cron-выражение) и срок
# хранения дампов в днях. Подробности и восстановление — docs/BACKUP.md.
# Расписание исполняет контейнер `backup` (в production, §26, — таймер
# systemd); ручной запуск и список копий живут в интерфейсе:
# «Настройки» → «Резервное копирование» (SPEC §11, §18 — только админ).
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
# Хост-порты docker-compose (закомментированы — значения ниже совпадают со
# значениями по умолчанию в docker-compose.yml). Переопределяйте, если порт
# занят другим приложением на хосте, ЛИБО если Docker не может забиндиться
# на него, хотя порт свободен (типично для Windows: ошибка вида
# "listen tcp4 127.0.0.1:5432: bind: forbidden by its access permissions" —
# признак того, что Hyper-V/WSL2-сеть или сторонний security-агент держат
# порт на уровне ОС, не показываясь ни в `netstat`, ни в
# `netsh int ipv4 show excludedportrange`). В таком случае проще подобрать
# свободный порт здесь, чем чинить сетевой стек ОС.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MEDIAMTX_RTSP_HOST_PORT=8554
# MEDIAMTX_HLS_HOST_PORT=8888
# MEDIAMTX_WEBRTC_HOST_PORT=8889
# BACKEND_HOST_PORT=8000
# FRONTEND_HTTP_HOST_PORT=8080
# FRONTEND_HTTPS_HOST_PORT=8443

# --- Корень медиаданных (SPEC §5 «путь архива конфигурируется под
# отдельный диск», §26 раскладка /var/lib/facewatch/) ---
# MEDIA_PATH — один на все сервисы: по нему бэкенд отдаёт файлы архива,
# воркер индексирует сегменты и считает retention, и из него же выводится
# recordPath для MediaMTX. В docker-compose это точка монтирования тома
# (/media), в режиме 2 §26 — каталог на диске архива.
# MEDIA_PATH=/media
#
# MEDIAMTX_MEDIA_PATH задавать НЕ нужно, если MediaMTX видит тот же
# каталог по тому же пути (так в docker-compose и так на .deb-развёртывании).
# Он нужен ровно для одного случая: MediaMTX смонтировал тот же том по
# другому адресу. Ошибиться здесь дорого — MediaMTX будет писать в один
# каталог, а архив индексировать другой: video_segments останется пустым,
# retention не удалит ничего, диск заполнится. Поэтому при заданном
# значении на карточке «Слой записи» висит предупреждение.
# MEDIAMTX_MEDIA_PATH=/media

# --- Сторож живости (SPEC §13 «авторестарт сервисов», §19 RTO ≤ 5 мин) ---
# Закрывает класс отказа «сервис жив и не отвечает». Важно понимать, зачем
# он вообще нужен: Docker НЕ перезапускает контейнер по красному
# healthcheck — он лишь метит его unhealthy, и заблокированный сервис
# остаётся в этом состоянии сколько угодно. Перезапуск делает сторож
# внутри процесса: выходит с кодом 17, на выход реагирует
# restart: unless-stopped.
#
# Значения ниже — умолчания; менять их стоит по итогам раздела 6.2
# docs/DEPLOY_CHECKLIST.md, когда видны фактические времена этапов объекта.
# Отключать (=0) имеет смысл только там, где перезапуском заведует внешний
# супервизор (systemd WatchdogSec в режиме 2 §26).
# WORKER_WATCHDOG_ENABLED=1
# WORKER_WATCHDOG_KILL_GRACE_SEC=60
# BACKEND_WATCHDOG_ENABLED=1
# BACKEND_WATCHDOG_LAG_BUDGET_SEC=60
# BACKEND_WATCHDOG_KILL_GRACE_SEC=60
