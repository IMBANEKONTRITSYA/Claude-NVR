# Пины артефактов, которые попадают в .deb (SPEC §26, режим 2).
#
# Здесь ровно те зависимости пакета, которые НЕ приходят из официальных
# репозиториев дистрибутива: переносимый CPython и статический бинарник
# MediaMTX. Всё остальное (postgresql, redis, nginx, ffmpeg) объявлено в
# Depends контрольного файла и ставится apt'ом — см. packaging/README.md.
#
# У каждого артефакта пин из ДВУХ частей: версия и sha256. Версии одной
# мало: тег на GitHub передвигается (BtbN/FFmpeg-Builds `latest` меняется
# ежедневно), а «скачали и запустили» без сверки — это доверие к сети на
# каждой сборке. Несовпадение обязано ронять сборку, а не печатать
# предупреждение.
#
# Версия MediaMTX здесь НЕ дублируется: она берётся из docker-compose.yml
# тем же способом, что и в джобе record-layer-live (.github/workflows/ci.yml).
# Иначе на объект поехал бы не тот сервер, против которого гонялись тесты
# слоя записи.

# Переносимый CPython (astral-sh/python-build-standalone). SPEC §26:
# «самодостаточный Python-рантайм ... без зависимости от системного python».
# install_only-сборка: без отладочных символов и тестов, ~46 МБ.
PBS_RELEASE=20250818
PBS_PYTHON=3.11.13
PBS_SHA256=b3d07471abdf1b3d2867dd44f095c891fb072bab5667b9322355546f9f9c5dda

# MediaMTX: sha256 к версии из docker-compose.yml. Смена версии там обязана
# сопровождаться сменой суммы здесь — сборка иначе падает, и это ровно то
# поведение, которое нужно: молча уехать на другой сервер записи нельзя.
MEDIAMTX_VERSION=1.16.0
MEDIAMTX_SHA256=59fe58273fb4c61d968cba61f69bf5c171034be62b2fe02b9dab7c1e859bb0c0

# Модель распознавания, вкладываемая в пакет (SPEC §15). Та же, что в
# worker/Dockerfile: объект видеонаблюдения обычно изолирован от интернета,
# и скачивание при первом вызове FaceAnalysis() там гарантированно не
# сработает.
FACE_MODEL=buffalo_s
