# Конфигурация FaceWatch (production, SPEC §26 режим 2).
#
# Файл создаётся скриптом первого запуска (/usr/sbin/facewatch-first-run) из
# этого шаблона: плейсхолдеры @...@ заменяются на сгенерированные секреты.
# Повторный запуск скрипта существующий файл НЕ трогает — правки оператора
# переживают `apt upgrade` (SPEC §26: «переустановка и апгрейд без потери
# данных»).
#
# Читается всеми юнитами facewatch-*. После правки:
#   systemctl restart facewatch.target

# ---------------------------------------------------------------- секреты
# Подпись JWT. Утечка = возможность подделать токен любого пользователя.
SECRET_KEY=@SECRET_KEY@
# AES-256 (Fernet) для RTSP-учёток камер и секретов в БД (SPEC §14).
# ВНИМАНИЕ: смена ключа делает уже сохранённые учётки камер нечитаемыми.
RTSP_ENCRYPTION_KEY=@RTSP_ENCRYPTION_KEY@
# Пароль администратора при первом старте. Он же напечатан в
# /etc/facewatch/ADMIN_PASSWORD при установке — смените его через интерфейс
# и удалите тот файл.
ADMIN_PASSWORD=@ADMIN_PASSWORD@
# Пароль Control API MediaMTX. Обязан совпадать со значением в
# /etc/facewatch/mediamtx.yml (authInternalUsers, пользователь facewatch) —
# скрипт первого запуска подставляет его в оба места.
MEDIAMTX_API_PASSWORD=@MEDIAMTX_API_PASSWORD@

# --------------------------------------------------------------- хранение
# Синхронная форма URL БД: её читают worker и upscaler (psycopg2).
# Асинхронную форму для backend (asyncpg) держит /etc/facewatch/backend.env —
# systemd не умеет собирать одну переменную из другой, поэтому их две.
DATABASE_URL=postgresql://facewatch:@DB_PASSWORD@@127.0.0.1:5432/facewatch
REDIS_URL=redis://127.0.0.1:6379/0
# Корень данных. Под архив обычно отводят отдельный диск — примонтируйте
# его в /var/lib/facewatch/media или укажите здесь другой путь и поправьте
# recordPath в /etc/facewatch/mediamtx.yml (SPEC §26).
MEDIA_PATH=/var/lib/facewatch/media

# ------------------------------------------------------------------ слои
# Слой записи: воркер заводит пути через Control API MediaMTX.
MEDIAMTX_API_URL=http://facewatch:@MEDIAMTX_API_PASSWORD@@127.0.0.1:9997
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_PORT=8554
# Глубина хранения архива по умолчанию (дни); по камерам настраивается в
# интерфейсе.
RETENTION_DAYS=30
# Бэкенд и воркер живут на одной машине, за общим nginx.
WORKER_URL=http://127.0.0.1:9000
# Фронтенд отдаётся тем же nginx (same-origin) — CORS в production не нужен.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- сторожа
# Сторож живости цикла событий/менеджера (SPEC §13, §19 RTO). Процесс
# выходит с кодом 17, юнит с Restart=always поднимает его заново.
BACKEND_WATCHDOG_ENABLED=1
BACKEND_WATCHDOG_LAG_BUDGET_SEC=60
BACKEND_WATCHDOG_KILL_GRACE_SEC=60
WORKER_WATCHDOG_ENABLED=1
WORKER_WATCHDOG_KILL_GRACE_SEC=60

# ---------------------------------------------------------------- апскейл
UPSCALE_BACKEND=gfpgan

# ------------------------------------------------------------------- логи
# Сервисы пишут структурированный JSON в stdout, systemd складывает его в
# journal (SPEC §26). Смотреть: journalctl -u facewatch-backend -f
LOG_LEVEL=INFO
